# 模型与运行配置示例（复制为 .env 后填写；仓库内绝不存放真实密钥）
#
# 运行模式：
#   mock   = 确定性策略规划器（无模型调用，可离线复现；所有记录标记 llm_mode=mock）
#   real   = 真实 OpenAI 兼容模型端点（需要下面的 BASE_URL / API_KEY / MODEL）
AGENT_LLM_MODE=mock
AGENT_LLM_BASE_URL=https://api.example.com/v1
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=

# 数据库（默认落在 data/runtime/diabetes_agent.db，测试时会自动使用临时库）
DIABETES_DB_PATH=
# 演示时钟：留空表示跟随系统时间；测试用 API/CLI 推进
DIABETES_CLOCK_OFFSET_SECONDS=0
# 后台自动调度的轮询间隔（秒）；0 表示只依赖显式 tick
AUTOMATION_POLL_SECONDS=30
# Web 前端（成员 C）开发地址，用于 CORS
FRONTEND_ORIGIN=http://127.0.0.1:5173
