    "test:e2e": "playwright test",
    "test:contract": "playwright test -c playwright.contract.config.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "antd": "^6.0.0",
    "@ant-design/icons": "^6.0.0",
    "echarts": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12",
    "@playwright/test": "^1.49.1"
  }
}
